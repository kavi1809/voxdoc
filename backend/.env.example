# Copy to .env and fill in. Never commit the real .env.

# ── Required ───────────────────────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Signs session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with the default value unless DEBUG=true.
SECRET_KEY=change-this-to-a-long-random-string

# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Models ─────────────────────────────────────────────────────────────────────
# Google retires Gemini models frequently, so these are configurable. Check
# https://ai.google.dev/gemini-api/docs/deprecations before pinning.
CHAT_MODEL=gemini-3.6-flash
SUMMARY_MODEL=gemini-3.5-flash-lite
TRANSCRIBE_MODEL=gemini-3.5-flash-lite

# ── Embeddings ─────────────────────────────────────────────────────────────────
# "local"  = fastembed / ONNX on CPU. No API calls, no cost, works offline.
# "gemini" = gemini-embedding-001 via the API.
# Switching this invalidates every stored vector: delete chroma_db/ and
# re-upload your documents, or retrieval will silently return nonsense.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Storage ────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
CHROMA_PERSIST_DIR=./chroma_db
MODEL_CACHE_DIR=./model_cache
DATABASE_URL=sqlite:///./voxdoc.db

# ── Limits ─────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_HISTORY_MESSAGES=10
AGENT_RECURSION_LIMIT=12
PANDAS_TIMEOUT_SECONDS=10
ACCESS_TOKEN_EXPIRE_DAYS=7
